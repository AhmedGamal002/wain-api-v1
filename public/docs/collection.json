                        "body": null,
                        "description": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a. \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u0638\u0627\u0647\u0631\u0629 \u0628\u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0644\u064a \u062d\u062f\u062f\u0647 \u0627\u0644\u0623\u062f\u0645\u0646 (A2): \u0634\u0631\u064a\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u0640 pins \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629.\n\u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0645\u062e\u0641\u064a \u0645\u0627 \u0628\u064a\u0631\u062c\u0639\u0634. \u0627\u0644\u0640 `slug` \u0645\u0627 \u0628\u064a\u062a\u063a\u064a\u0631\u0634\u060c \u0641\u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u064a\u0641\u0644\u062a\u0631 \u0628\u064a\u0647. \u0628\u064a\u062a\u062e\u0632\u0646 \u0641\u064a cache \u0633\u0627\u0639\u0629 \u0648\u0628\u064a\u062a\u0645\u0633\u062d \u0645\u0639\n\u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0645\u0646 \u0627\u0644\u0644\u0648\u062d\u0629.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"data\": [{\"slug\": \"cafes\", \"name\": \"\u0643\u0627\u0641\u064a\u0647\u0627\u062a\", \"icon\": \"\u2615\", \"color\": \"#6F4E37\"}, {\"slug\": \"restaurants\", \"name\": \"\u0645\u0637\u0627\u0639\u0645\", \"icon\": \"\ud83c\udf7d\ufe0f\", \"color\": \"#E8593C\"}]}",
