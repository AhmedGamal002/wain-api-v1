                {
                    "name": "Get place details",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/v1\/places\/:slug",
                            "query": [
                                {
                                    "key": "lat",
                                    "value": "30.03",
                                    "description": "\u062e\u0637 \u0639\u0631\u0636 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u062d\u0633\u0627\u0628 `distance_km`. \u0644\u0627\u0632\u0645 \u0645\u0639 `lng`. This field is required when lng is present. value \u0644\u0627\u0632\u0645 \u064a\u0643\u0648\u0646 \u0628\u064a\u0646 -90 \u064890.",
                                    "disabled": false
                                },
                                {
                                    "key": "lng",
                                    "value": "31.47",
                                    "description": "\u062e\u0637 \u0637\u0648\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u060c \u0644\u062d\u0633\u0627\u0628 `distance_km`. \u0644\u0627\u0632\u0645 \u0645\u0639 `lat`. This field is required when lat is present. value \u0644\u0627\u0632\u0645 \u064a\u0643\u0648\u0646 \u0628\u064a\u0646 -180 \u0648180.",
                                    "disabled": false
                                }
                            ],
                            "raw": "{{baseUrl}}\/api\/v1\/places\/:slug?lat=30.03&lng=31.47",
                            "variable": [
                                {
                                    "id": "slug",
                                    "key": "slug",
                                    "value": "el-mahatta-coffee",
                                    "description": "slug \u0627\u0644\u0645\u0643\u0627\u0646."
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept-Language",
                                "value": "ar"
                            }
                        ],
                        "body": null,
                        "description": "\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0643\u0627\u0646. \u0635\u0641\u062d\u0629 \u0627\u0644\u0645\u0643\u0627\u0646 (F7): \u0643\u0644 \u062d\u0642\u0648\u0644 \u0627\u0644\u0643\u0627\u0631\u062a + \u0627\u0644\u0648\u0635\u0641 \u0648\u0627\u0644\u0639\u0646\u0648\u0627\u0646 \u0648\u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0648\u0627\u0644\u062e\u0635\u0627\u0626\u0635 (\u0645\u062a\u062c\u0645\u0651\u0639\u0629) \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0648\u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f\n\u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0646\u064a\u0648.\n\n- \u0628\u064a\u0631\u062c\u0651\u0639 \u0627\u0644\u0645\u0646\u0634\u0648\u0631 (`status = active`) \u0648\u0627\u0644\u0645\u063a\u0644\u0642 \u0646\u0647\u0627\u0626\u064a\u0627\u064b (`status = closed`) \u0628\u0633. \u063a\u064a\u0631 \u0643\u062f\u0647 (\u0645\u062e\u0641\u064a \u0623\u0648 \u0645\u0633\u0648\u062f\u0629 \u0623\u0648\n  \u0642\u064a\u062f \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0648 \u0645\u0631\u0641\u0648\u0636 \u0623\u0648 \u0645\u062d\u0630\u0648\u0641 \u0623\u0648 \u0645\u0634 \u0645\u0648\u062c\u0648\u062f) 404 `PLACE_NOT_AVAILABLE` \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u063a\u064a\u0631 \u0645\u0627 \u062a\u0643\u0634\u0641 \u0627\u0644\u0633\u0628\u0628.\n- \u0627\u0644\u0645\u063a\u0644\u0642 \u0646\u0647\u0627\u0626\u064a\u0627\u064b: `is_open_now` \u0648`hours.status_text` \u0628\u0640 `null` \u0648`hours.week` \u0641\u0627\u0636\u064a\u0629\u060c \u0648\u0627\u0644\u0645\u0648\u0628\u0627\u064a\u0644 \u0628\u064a\u0639\u0631\u0636\n  \u0628\u0627\u0646\u0631 \u00ab\u0627\u0644\u0645\u0643\u0627\u0646 \u062f\u0647 \u0642\u0641\u0644 \u0646\u0647\u0627\u0626\u064a\u0627\u064b\u00bb \u0648\u0628\u064a\u062e\u0641\u064a \u0623\u0632\u0631\u0627\u0631 \u0627\u0644\u062a\u0648\u0627\u0635\u0644.\n- \u0627\u0644\u0640 slug \u0627\u0644\u0642\u