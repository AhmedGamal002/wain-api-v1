# قالب فاضي. ما تعدّلش الملف ده: هو متتبَّع في git وأي باسورد فيه هيتعمله commit.
# انسخه محلياً باسم .hosting-check.env (git بيتجاهله) واملى النسخة دي، وارفعها على السيرفر.
#
# استخدم داتابيز فاضية مخصوصة للتجربة. السكريبت بيعمل جداول wain_trial_* ويمسحها في الآخر.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# للتشغيل من المتصفح بس (16 حرف أو أكتر، عشوائي). السكريبت بيرفض أي طلب من غيره.
# في نسخة الويب حط CHECK_KEY بس، من غير بيانات الداتابيز.
CHECK_KEY=
